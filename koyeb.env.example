# 🐰 PaySentinelIQ — Template de Variáveis para Koyeb
# Copie para Settings → Environment Variables → Raw Editor no Koyeb
# ⚠️ SUBSTITUA OS VALORES ENTRE [COLCHETES] PELOS SEUS VALORES REAIS

# ── Application ──
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ── Server ──
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["https://pay-sentinel-iq.vercel.app","http://localhost:3000"]

# ── Database (Supabase) ──
# Já configurado no seu .env local — copie a mesma URL
DATABASE_URL=postgresql+asyncpg://[USER]:[PASSWORD]@[HOST]:[PORT]/[DB]?ssl=require

# ── Google OAuth ──
GOOGLE_CLIENT_ID=701434590028-kulmv1ocov07s4qhkpdca0tlcntvft0e.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=[SEU_GOOGLE_CLIENT_SECRET]
NEXT_PUBLIC_GOOGLE_CLIENT_ID=701434590028-kulmv1ocov07s4qhkpdca0tlcntvft0e.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_API_KEY=[SUA_GOOGLE_API_KEY]
NEXT_PUBLIC_API_URL=https://[SEU_APP].koyeb.app
NEXT_PUBLIC_WS_BASE_URL=wss://[SEU_APP].koyeb.app/ws
GOOGLE_REDIRECT_URI=https://[SEU_APP].koyeb.app/auth/google/callback

# ── Redis (Upstash) ──
# Crie em upstash.com → Redis → Free → copie a URL (rediss://...)
REDIS_URL=rediss://default:[SUA_SENHA]@[SEU_HOST].upstash.io:6379
CELERY_BROKER_URL=rediss://default:[SUA_SENHA]@[SEU_HOST].upstash.io:6379/1
CELERY_RESULT_BACKEND=rediss://default:[SUA_SENHA]@[SEU_HOST].upstash.io:6379/2

# ── JWT Auth ──
# Gere com: openssl rand -hex 32
JWT_SECRET_KEY=[SUA_CHAVE_32_BYTES_HEX]
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AWS (se usa S3/Textract) ──
AWS_ACCESS_KEY_ID=[SUA_AWS_ACCESS_KEY]
AWS_SECRET_ACCESS_KEY=[SUA_AWS_SECRET_KEY]
AWS_REGION=us-east-2
S3_BUCKET=[SEU_BUCKET_S3]

# ── AI / LLM ──
LLM_PROVIDER=gemini
GEMINI_API_KEY=[SUA_GEMINI_API_KEY]
GEMINI_MODEL=gemini-2.5-flash
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=4096

# ── Sentry (opcional) ──
SENTRY_DSN=[SEU_SENTRY_DSN]

# ── Feature Flags ──
ENABLE_AI_AGENTS=true
ENABLE_OCR=true
ENABLE_COMPLIANCE_CHECKS=true

# ── RabbitMQ (CloudAMQP) ──
# Crie em cloudamqp.com → Little Lemur (Free) → copie a URL completa
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqps://[USER]:[PASS]@[HOST]/[VHOST]
RABBITMQ_EXCHANGE=sentinel.events
RABBITMQ_DLX=sentinel.dlx
RABBITMQ_PREFETCH_COUNT=10
EVENT_SOURCE=paysentinel-api
EVENT_RETRY_MAX_ATTEMPTS=3
EVENT_RETRY_BACKOFF_SECONDS=5,30,120

# ── Email (opcional) ──
EMAIL_ENABLED=false
EMAIL_FROM="SentinelaPay <no-reply@seudominio.com>"
SMTP_HOST=[SEU_SMTP_HOST]
SMTP_PORT=587
SMTP_USERNAME=[SEU_SMTP_USER]
SMTP_PASSWORD=[SUA_SMTP_SENHA]
SMTP_USE_TLS=true
APP_BASE_URL=https://[SEU_APP].koyeb.app

# ── Bill Scheduler ──
BILL_SCHEDULER_ENABLED=true
BILL_SCHEDULER_INTERVAL_SECONDS=3600
BILL_DUE_SOON_DAYS=2

# ── Feature Flags ──
ENABLE_AI_AGENTS=true
ENABLE_OCR=true
ENABLE_COMPLIANCE_CHECKS=true