# ============================================================
# PaySentinelIQ — Environment Variables
# Copy to .env and fill in secrets for production
#
# IMPORTANT: DATABASE_URL Normalization
# Render provides DATABASE_URL as "postgresql://..." (psycopg2, sync).
# The application code normalizes this automatically to "postgresql+asyncpg://..."
# for the async SQLAlchemy engine. For Alembic migrations, a sync version
# ("postgresql+psycopg://...") is derived from the same variable.
# DO NOT manually change the scheme — let the normalization handle it.
# ============================================================

# ── Application ──
APP_NAME=PaySentinelIQ
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ── Server ──
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","https://pay-sentinel-iq.vercel.app"]

# ── Database ──
# Render provides postgresql://... — code normalizes to postgresql+asyncpg:// for async engine
# and postgresql+psycopg:// for Alembic sync migrations.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/paysentineliq

# ── Redis ──
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── RabbitMQ (event-driven messaging) ──
# Set RABBITMQ_ENABLED=false to run the API without a broker (events are
# dropped by a no-op publisher — dev only). Workers refuse to start.
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://psi:psi_secret@localhost:5672/
# Docker local: set RABBITMQ_DEFAULT_USER / RABBITMQ_DEFAULT_PASS on the
# `rabbitmq` compose service to match this URL (least-privilege user).
RABBITMQ_EXCHANGE=sentinel.events
RABBITMQ_DLX=sentinel.dlx
RABBITMQ_PREFETCH_COUNT=10
EVENT_SOURCE=paysentinel-api
# Retry: max attempts before DLQ + backoff per attempt (CSV seconds).
EVENT_RETRY_MAX_ATTEMPTS=3
EVENT_RETRY_BACKOFF_SECONDS=5,30,120

# ── Email (transactional — sent by the email worker only) ──
# EMAIL_ENABLED=false → the worker logs emails instead of sending (dev).
EMAIL_ENABLED=false
EMAIL_FROM="SentinelaPay <no-reply@paysentineliq.com>"
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Public frontend URL — used for links inside emails.
APP_BASE_URL=http://localhost:3000

# ── Bill due-soon scheduler ──
BILL_SCHEDULER_ENABLED=true
BILL_SCHEDULER_INTERVAL_SECONDS=3600
BILL_DUE_SOON_DAYS=2

# ── JWT Auth ──
JWT_SECRET_KEY=change-me-in-production-use-256-bit-minimum-key
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Google OIDC (Sign In With Google) ──
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-backend-domain.com/auth/google/callback

# ── AWS ──
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET=psi-documents

# ── AI / LLM Provider ──
# Provider selection: ollama (local, zero-cost), gemini (cloud, prod), openai (cloud),
# openai_compatible / lmstudio (LM Studio or any OpenAI-compatible endpoint)
# Auto-selected by ENVIRONMENT:
#   demo        → ollama (Qwen3 1.7B via Ollama — install: `ollama pull qwen3:1.7b`)
#   development → ollama (Qwen3 4B via Ollama — install: `ollama pull qwen3:4b-q4_k_m`)
#   production  → gemini (requires GEMINI_API_KEY)
LLM_PROVIDER=ollama

# ── OpenAI-compatible LLM (LM Studio local / cloud) ──
# LLM_PROFILE takes precedence over ENVIRONMENT. Values: local, cloud, or empty
# (empty preserves the ENVIRONMENT-based provider selection above).
# Inside Docker, the host machine is reachable as host.docker.internal:1234.
#
# Local example (LM Studio):
# LLM_PROFILE=local
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=qwen3.5-4b@q4_k_m
# LLM_TEMPERATURE=0.1          # Empty keeps the current shared temperature
# LLM_TIMEOUT=180
# LLM_MAX_RETRIES=3
# LLM_REASONING_EFFORT=none
# LLM_MAX_CONCURRENCY=1
# LLM_API_KEY=                 # Optional; LM Studio does not require a key
#
# Cloud example (any OpenAI-compatible endpoint):
# LLM_PROFILE=cloud
# LLM_BASE_URL=https://your-provider.example.com/v1
# LLM_MODEL=your-model-name
# LLM_TEMPERATURE=0.1          # Empty keeps the current shared temperature
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=3
# LLM_REASONING_EFFORT=none
# LLM_MAX_CONCURRENCY=4
# LLM_API_KEY=your-api-key

# ── OCR ──
# ENABLE_CANONICAL_EXTRACTION=true
# OCR_PROVIDER=tesseract
# OCR_PADDLE_LANG=latin
# OCR_MAX_PAGES=10
# OCR_NATIVE_TEXT_MIN_CHARS=50
# OCR_SERVICE_URL=http://localhost:8010
# OCR_SERVICE_TIMEOUT=120
# OCR_SERVICE_API_KEY=
# OCR_SERVICE_ENGINE=tesseract

# ── Ollama (Local LLM — Zero API Cost) ──
# Install Ollama: https://ollama.com/download
# Then pull the model for your environment:
#   Demo:        ollama pull qwen3:1.7b
#   Development: ollama pull qwen3:4b-q4_k_m
#   Production:  ollama pull llama3 (or your preferred model)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=120.0
OLLAMA_MAX_RETRIES=3
# OLLAMA_NUM_GPU=            # Auto-detect (set 0 for CPU-only)
# OLLAMA_NUM_THREAD=         # Auto-detect

# ── AI Shared Settings ──
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=4096

# ── Gemini (Google AI — production cloud LLM, recommended for prod) ──
# Set LLM_PROVIDER=gemini to activate this provider
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash

# ── OpenAI (Cloud — optional, only if LLM_PROVIDER=openai) ──
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# ── Sentry ──
SENTRY_DSN=https://your-sentry-key@oXXXXXX.ingest.us.sentry.io/XXXXXX

# ── Data Breach / ANPD (LGPD Art. 48) ──
# ANPD_NOTIFICATION_EMAIL=anpd@example.gov.br   # Real ANPD notification address
# BREACH_DEADLINE_HOURS=72                      # 72-hour notification window
# BREACH_AFFECTED_THRESHOLD=50                  # Auto-notify subjects above this count
# BREACH_AUTO_NOTIFY_ANPD=true                  # Auto-trigger notification on registration

# ── Rate Limiting ──
# RATE_LIMIT_PER_USER=100       # Max API requests per window per user
# RATE_LIMIT_WINDOW=60          # Window in seconds
# RATE_LIMIT_LOGIN_MAX=5        # Max login attempts per window

# ── Feature Flags ──
ENABLE_AI_AGENTS=false
ENABLE_OCR=false
ENABLE_COMPLIANCE_CHECKS=false

# ── Variables REQUIRED on Render (production) ──
# DATABASE_URL          # Provided by Render PostgreSQL (postgresql://...)
# REDIS_URL             # Provided by Render Redis (rediss://...)
# GOOGLE_CLIENT_ID      # From Google Cloud Console
# GOOGLE_CLIENT_SECRET  # From Google Cloud Console
# JWT_SECRET_KEY        # Generate: openssl rand -base64 32
# GEMINI_API_KEY        # Required if LLM_PROVIDER=gemini (production default)
# CORS_ORIGINS          # Must include https://pay-sentinel-iq.vercel.app (no trailing slash)
# SENTRY_DSN            # Optional but recommended
